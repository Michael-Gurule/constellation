# .gitignore for constellation

# Python / bytecode
__pycache__/
*.py[cod]
*$py.class

# C extensions
*.so
*.dylib
*.pyd

# Virtual environments
.venv/
venv/
env/
ENV/
env.bak/
venv.bak/

# Distribution / packaging
build/
dist/
eggs/
*.egg
*.egg-info/
pip-wheel-metadata/
*.whl

# Installer logs
pip-log.txt
pip-delete-this-directory.txt

# Tests / coverage
.coverage
.coverage.*
coverage.xml
htmlcov/
.tox/
.nox/
.pytest_cache/
.hypothesis/
.benchmarks/
nosetests.xml
junit-*.xml

# Type checking / lint caches
.mypy_cache/
.pyre/
.ruff_cache/

# Jupyter (the walkthrough notebook is un-ignored when it is added)
*.ipynb
.ipynb_checkpoints/

# Environment variables / secrets
.env
.env.*
!.env.example

# Generated data (manifests and directory placeholders stay tracked)
data/*
!data/manifests/
!data/*/
data/*/*
!data/*/.gitkeep
!data/manifests/**

# Model artifacts, run outputs and logs (top-level only; src/**/models is code)
/models/
/runs/
/logs/
*.log
*.pkl
*.joblib
*.pt

# Local working notes
notes/
REFACTOR_PLAN.md

# Design assets (published logos stay tracked)
/assets/*
!/assets/logo*.svg

# Editors
.vscode/
*.code-workspace

# Misc
*.sqlite3
*.db
.DS_Store
